# turret-control environment file
#
# Installed to /etc/turret-control/turret.env with 0640 root:turret permissions.
# This file holds secrets - it must never be committed to git.
# Everything here is optional; the defaults are safe for a trusted LAN.

# --- HTTP ---------------------------------------------------------------
TURRET_HOST=0.0.0.0
TURRET_PORT=8080

# --- Paths --------------------------------------------------------------
TURRET_DATA_DIR=/var/lib/turret-control
# TURRET_MODELS_DIR=/var/lib/turret-control/models
# TURRET_SNAPSHOT_DIR=/var/lib/turret-control/snapshots

# --- Logging ------------------------------------------------------------
TURRET_LOG_LEVEL=INFO
# console (human readable, good in journalctl) or json (for log shipping)
TURRET_LOG_FORMAT=console

# --- Security -----------------------------------------------------------
# Enable to require a login for the web UI.
TURRET_AUTH_ENABLED=false
TURRET_AUTH_USERNAME=admin
TURRET_AUTH_PASSWORD=

# Pre-shared token the ESP32 must present when it connects.
# Generate with:  openssl rand -hex 24
TURRET_CONTROLLER_TOKEN=

# Session signing key. Generated into the data dir automatically if empty.
TURRET_SECRET_KEY=

# Comma separated, only needed if the UI is served from another origin.
# TURRET_CORS_ORIGINS=http://localhost:5173

# --- Camera credentials -------------------------------------------------
# Camera URLs configured in the UI may reference ${VARIABLES} defined here,
# so passwords stay out of the database and out of the UI.
# CAM_PASSWORD=changeme
# Example URL to enter in the UI:
#   rtsp://admin:${CAM_PASSWORD}@192.168.1.50:554/h264Preview_01_sub

# --- Development without hardware ---------------------------------------
# TURRET_FORCE_SIMULATED_CAMERA=true
# TURRET_FORCE_MOCK_DETECTOR=true
