# Normalise line endings.
#
# This repository is developed on Windows and deployed on Linux. A shell
# script or a systemd unit with CRLF endings does not merely look odd - it
# fails at runtime ("bad interpreter: /usr/bin/env bash^M"), so the ending is
# pinned in the repository rather than left to whoever cloned it.

* text=auto eol=lf

# Files that must be LF no matter what the local git config says.
*.sh          text eol=lf
*.py          text eol=lf
*.service     text eol=lf
*.conf        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
Makefile      text eol=lf
.env.example  text eol=lf

# Binary: never touched.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.pt     binary
*.onnx   binary
*.bin    binary
