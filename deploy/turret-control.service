[Unit]
Description=Turret control server (pigeon deterrent / camera ball turret)
Documentation=https://github.com/angeeinstein/pigeon-tracker
After=network-online.target
Wants=network-online.target

# Never give up after repeated crashes: an unattended turret should keep
# trying to come back rather than sit dead until someone notices. This key
# only takes effect in [Unit]; systemd silently ignores it in [Service].
StartLimitIntervalSec=0

[Service]
Type=exec
User=turret
Group=turret
# The working directory is the *models* directory, not the code directory.
# Ultralytics downloads weights relative to the CWD on first use, and the code
# directory is read-only (ProtectSystem=strict). Pointing the CWD at the models
# directory means a downloaded model lands exactly where the detector looks for
# it on the next start.
WorkingDirectory=/var/lib/turret-control/models
Environment=PYTHONPATH=/opt/turret-control/server
Environment=HOME=/var/lib/turret-control
Environment=YOLO_CONFIG_DIR=/var/lib/turret-control/models/.ultralytics
Environment=MPLCONFIGDIR=/var/lib/turret-control/models/.matplotlib
EnvironmentFile=/etc/turret-control/turret.env

# One worker, deliberately: this process owns the controller WebSocket, the
# camera decoders and the loaded model. See server/gunicorn.conf.py.
ExecStart=/opt/turret-control/venv/bin/gunicorn \
    --config /opt/turret-control/server/gunicorn.conf.py \
    app.main:app
ExecReload=/bin/kill -s HUP $MAINPID

# Give the app time to close the valve and stop motion before it is killed.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=turret-control

# --- hardening -----------------------------------------------------------
# The service needs nothing outside its own data directory.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/var/lib/turret-control
# Loosen only if a future feature needs it (e.g. USB hardware access).
DeviceAllow=

[Install]
WantedBy=multi-user.target
